# syntax=docker/dockerfile:1

# Development image for the NestJS server.
# Source code is bind-mounted via docker-compose.dev.yml, so this image only
# needs the dependencies installed. Nest's --watch handles live reload.
FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=development

COPY package.json package-lock.json ./
RUN npm ci

# Source is mounted at runtime; copy as a fallback for standalone runs.
COPY . .

EXPOSE 3005

CMD ["npm", "run", "start:dev"]
