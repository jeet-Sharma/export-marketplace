# Copy to .env for local development. Never commit the real .env file.

PORT=3000

# AWS / LocalStack
# In production, AWS_ENDPOINT is left empty so the SDK talks to real AWS.
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3
AWS_S3_BUCKET=export-marketplace-documents

# SQS
AWS_SQS_QUEUE_NAME=export-marketplace-events
