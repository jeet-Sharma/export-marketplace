# Copy to .env for local development. Never commit the real .env file.

PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# These defaults match the postgres service in docker-compose.yml.
# Run "npm run infra:up" to start the container, then start the app normally.
# In production, set all five vars explicitly — synchronize is disabled and
# ssl is enabled automatically when NODE_ENV=production (see db.config.ts).
#
# POSTGRES_PORT is the HOST port the app (running directly on your machine,
# outside docker compose) connects to. It's intentionally non-default
# (55432, not 5432) so this project's Postgres container never collides with
# another project's Postgres also bound to the standard port on the same
# machine. POSTGRES_HOST_PORT is the compose-only var controlling the actual
# host-side mapping in docker-compose.yml — keep the two in sync if you
# change either. Containers still talk to each other over 5432 internally
# (see the "app" service's hardcoded POSTGRES_PORT in docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_HOST_PORT=55432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=export_marketplace

# Set to "true" to enable TypeORM query logging in any environment.
TYPEORM_LOGGING=false

# ─── AWS / LocalStack ─────────────────────────────────────────────────────────
# In production, leave AWS_ENDPOINT unset so the SDK talks to real AWS.
# Run "npm run localstack:up" to start LocalStack for local development.
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3
AWS_S3_BUCKET=export-marketplace-documents

# SQS
AWS_SQS_QUEUE_NAME=export-marketplace-events


AUTH_ACCESS_SECRET=replace-with-a-long-random-access-secret
AUTH_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com
FRONTEND_URL=http://localhost:3000

# ─── Observe (optional telemetry) ─────────────────────────────────────────────
# Leave both unset to run without telemetry. Set both to enable @nestjs/observe.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

