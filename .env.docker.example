# Root-level environment file for Docker Compose.
# Copy to ".env" in the repository root before running compose:
#
#   cp .env.docker.example .env
#
# Compose automatically loads a ".env" file in the same directory. The dev
# stack has safe loopback-only defaults, but the production stack (see
# docker-compose.yml) REQUIRES the secrets below to be set and will refuse to
# start otherwise. NEVER commit a real .env with production secrets.

# ─── Host port mappings ───────────────────────────────────────────────────────
# Change these if the ports are already in use on your machine.
API_HOST_PORT=3005
WEB_HOST_PORT=3000
POSTGRES_HOST_PORT=55432
LOCALSTACK_HOST_PORT=4566

# ─── Client -> API URL (used at build time by Next.js) ────────────────────────
# This is called from the browser, so it must point at a host-reachable address.
NEXT_PUBLIC_API_URL=http://localhost:3005

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Origin(s) the API accepts credentialed cross-origin requests from (the
# browser calling from the web container's published host port). Comma-
# separate multiple origins. Must match where the web app is actually served.
CORS_ORIGIN=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# REQUIRED for the production stack: it refuses to start unless POSTGRES_USER
# and POSTGRES_PASSWORD are set. Use a strong, unique password — the published
# port is bound to 127.0.0.1 so the DB is only reachable from this host, but
# weak credentials are still a risk.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=export_marketplace

# ─── Storage provider ──────────────────────────────────────────────────────────
# Selects which StorageStrategy nest-server uses for product image uploads
# (nest-server/src/storage/storage.module.ts). Neither compose file sets this
# — both intentionally default to "s3" (LocalStack in dev, real AWS in
# production) so Docker Compose behavior is unaffected by Cloudinary's
# addition. Cloudinary is only relevant for the npm-run-start:dev workflow
# outside Docker (CLOUDINARY_* below); it is not wired into either compose
# stack.
# STORAGE_PROVIDER=s3

# ─── AWS / LocalStack ─────────────────────────────────────────────────────────
# AWS_ENDPOINT is set to the LocalStack address by the compose files. Its
# presence is what puts the API in "local" mode: it talks to LocalStack and
# rewrites presigned URL hosts (see AWS_S3_PUBLIC_ENDPOINT). In production
# AWS_ENDPOINT is left empty and the SDK uses real AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=export-marketplace-documents
# Host-reachable base URL for presigned S3 links. The SDK signs URLs against
# the internal "http://localstack:4566" endpoint, which only resolves inside
# the Docker network; this value replaces that host so a browser on your
# machine can open download links. OPT-IN with NO default — if you leave it
# unset, presigned URLs are returned unchanged. The dev stack sets it to
# http://localhost:4566 automatically. Only set it here if your published
# LocalStack port differs or you run the stack somewhere other than localhost.
AWS_S3_PUBLIC_ENDPOINT=http://localhost:4566

# Mount the UNAUTHENTICATED /aws-demo S3 helper routes. OFF by default and
# only honored when AWS_ENDPOINT points at LocalStack. The dev stack sets this
# to true; NEVER enable it in a deployed/production environment.
ENABLE_AWS_DEMO_ROUTES=false

# ─── Cloudinary ─────────────────────────────────────────────────────────────────
# Only read when STORAGE_PROVIDER=cloudinary (see above) — unused by either
# compose stack today. Get these from your Cloudinary dashboard; the free
# plan is sufficient for development.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# REQUIRED for the production stack: the api service refuses to start unless
# both secrets are set (docker-compose.yml's ${VAR:?...} guard), AND
# nest-server/src/config/jwt.config.ts refuses to boot in production
# (NODE_ENV=production) if either is missing, is a known placeholder value,
# or if the two are equal to each other.
#
# Deliberately left BLANK below rather than filled with a placeholder —
# publicly-known example values (e.g. a literal "change-me-access-secret")
# can be used by anyone to forge a valid JWT if accidentally left in a real
# deployment, and a non-empty value is enough to satisfy docker-compose's
# presence-only ${VAR:?...} check. Generate a real value for each secret
# before running the production stack, e.g.:
#
#   openssl rand -hex 32
#
# Use two DIFFERENT generated values — jwt.config.ts rejects access and
# refresh secrets being equal.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
