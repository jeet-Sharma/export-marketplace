# Base URL of the nest-server API. The server sets a global /api/v1 prefix
# (see nest-server/src/main.ts) and runs on PORT=3005 in local dev.
# NEXT_PUBLIC_* vars are exposed to the browser — only put non-secret values here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3005/api/v1

# Public (browser-reachable) base URL for S3/LocalStack presigned image URLs.
# In Docker dev, LocalStack is published on port 4566; next.config.ts reads
# this to allow-list the host in next/image remotePatterns.
# Leave unset when using Cloudinary (STORAGE_PROVIDER=cloudinary).
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:4566
